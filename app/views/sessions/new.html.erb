<div class="min-h-screen bg-gradient-to-br from-amber-50 via-orange-50 to-yellow-50 flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full space-y-8">
    <div class="text-center">
      <div class="flex items-center justify-center space-x-2 mb-4">
        <svg class="w-12 h-12 text-amber-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
        <h1 class="text-4xl font-bold text-amber-900">Readify</h1>
      </div>
      <h2 class="text-2xl font-semibold text-gray-900">ログイン</h2>
      <p class="mt-2 text-gray-600">あなたの本棚へようこそ</p>
    </div>

    <% if flash[:alert] %>
      <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <%= form_with url: login_path, method: :post, class: "mt-8 space-y-6 bg-white p-8 rounded-2xl shadow-xl" do |f| %>
      <div class="space-y-4">
        <div>
          <%= f.label :email, "メールアドレス", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.email_field :email, required: true, autofocus: true, autocomplete: "email",
              class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-transparent transition-all" %>
        </div>

        <div>
          <%= f.label :password, "パスワード", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.password_field :password, required: true, autocomplete: "current-password",
              class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-transparent transition-all" %>
        </div>
      </div>

      <div>
        <%= f.submit "ログイン", class: "w-full flex justify-center py-3 px-4 border border-transparent rounded-lg shadow-sm text-lg font-semibold text-white bg-gradient-to-r from-amber-600 to-orange-600 hover:from-amber-700 hover:to-orange-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-amber-500 transition-all transform hover:scale-105" %>
      </div>

      <div class="text-center">
        <p class="text-sm text-gray-600">
          アカウントをお持ちでないですか？
          <%= link_to "新規登録", signup_path, class: "font-semibold text-amber-600 hover:text-amber-700 transition-colors" %>
        </p>
      </div>
    <% end %>

    <div class="text-center">
      <%= link_to "← ホームに戻る", root_path, class: "text-gray-600 hover:text-amber-700 transition-colors" %>
    </div>
  </div>
</div>
