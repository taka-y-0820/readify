<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-4xl font-bold text-amber-800">読書リスト</h1>
    <%= link_to '本を探す', books_path, class: 'bg-amber-600 text-white px-6 py-2 rounded-lg hover:bg-amber-700 transition-colors' %>
  </div>

  <!-- 統計情報 -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
    <div class="bg-white p-6 rounded-lg shadow-md border-l-4 border-amber-600">
      <div class="text-sm text-gray-600 mb-1">登録本数</div>
      <div class="text-3xl font-bold text-amber-800"><%= @stats[:total] %></div>
    </div>
    <div class="bg-white p-6 rounded-lg shadow-md border-l-4 border-green-600">
      <div class="text-sm text-gray-600 mb-1">読了済み</div>
      <div class="text-3xl font-bold text-green-600"><%= @stats[:finished] %></div>
    </div>
    <div class="bg-white p-6 rounded-lg shadow-md border-l-4 border-blue-600">
      <div class="text-sm text-gray-600 mb-1">読書中</div>
      <div class="text-3xl font-bold text-blue-600"><%= @stats[:in_progress] %></div>
    </div>
  </div>

  <!-- 読書リスト -->
  <% if @readings.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @readings.each do |reading| %>
        <div class="bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow overflow-hidden">
          <!-- 本の画像 -->
          <% if reading.book.image_url.present? %>
            <div class="aspect-square overflow-hidden bg-gray-200">
              <%= image_tag reading.book.image_url, alt: reading.book.title, class: 'w-full h-full object-cover' %>
            </div>
          <% else %>
            <div class="aspect-square bg-gradient-to-br from-amber-100 to-amber-200 flex items-center justify-center">
              <svg class="w-16 h-16 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
            </div>
          <% end %>

          <!-- 本の情報 -->
          <div class="p-4">
            <h3 class="font-bold text-amber-800 mb-1 line-clamp-2"><%= reading.book.title %></h3>
            <p class="text-sm text-gray-600 mb-3 line-clamp-1"><%= reading.book.author %></p>

            <!-- 進捗バー -->
            <div class="mb-4">
              <div class="flex justify-between items-center mb-2">
                <span class="text-xs text-gray-600">進捗</span>
                <span class="text-sm font-semibold text-amber-700"><%= reading.progress || 0 %>%</span>
              </div>
              <div class="w-full bg-gray-200 rounded-full h-2">
                <div 
                  class="<%= reading.finished? ? 'bg-green-500' : 'bg-amber-500' %> h-2 rounded-full transition-all" 
                  style="width: <%= reading.progress || 0 %>%"
                ></div>
              </div>
            </div>

            <!-- ステータスとアクション -->
            <div class="flex justify-between items-center mb-4">
              <% if reading.finished? %>
                <span class="inline-block bg-green-100 text-green-800 text-xs font-semibold px-3 py-1 rounded-full">読了済み</span>
              <% else %>
                <span class="inline-block bg-blue-100 text-blue-800 text-xs font-semibold px-3 py-1 rounded-full">読書中</span>
              <% end %>
            </div>

            <!-- 更新・削除ボタン -->
            <div class="flex gap-2">
              <%= button_to '削除', reading_path(reading), method: :delete, 
                  data: { confirm: '本当に削除しますか？' }, 
                  class: 'flex-1 bg-red-500 text-white px-3 py-2 rounded text-sm hover:bg-red-600 transition-colors' %>
              <%= link_to '編集', 
                  "#{readings_path(reading)}#edit",
                  class: 'flex-1 bg-amber-600 text-white px-3 py-2 rounded text-sm text-center hover:bg-amber-700 transition-colors' %>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <!-- モーダル形式の進捗編集 -->
    <% @readings.each do |reading| %>
      <div id="edit-<%= reading.id %>" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50">
        <div class="bg-white p-8 rounded-lg max-w-md w-full mx-4">
          <h2 class="text-2xl font-bold text-amber-800 mb-6"><%= reading.book.title %></h2>
          
          <%= form_with model: reading, method: :patch, local: true do |form| %>
            <div class="mb-4">
              <%= form.label :progress, '進捗 (%)' %>
              <%= form.number_field :progress, min: 0, max: 100, class: 'w-full px-4 py-2 border border-gray-300 rounded-lg' %>
              <input type="range" name="reading[progress]" min="0" max="100" value="<%= reading.progress || 0 %>" class="w-full mt-2" id="progress-slider-<%= reading.id %>" 
                oninput="document.querySelector('input[name=\"reading[progress]\"][type=number]').value = this.value">
            </div>

            <div class="mb-6">
              <%= form.label :finished, class: 'flex items-center cursor-pointer' do %>
                <%= form.checkbox :finished, class: 'mr-2' %>
                <span>読了済みにする</span>
              <% end %>
            </div>

            <div class="flex gap-3">
              <%= form.submit '更新', class: 'flex-1 bg-amber-600 text-white px-4 py-2 rounded-lg hover:bg-amber-700 transition-colors' %>
              <button type="button" class="flex-1 bg-gray-300 text-gray-800 px-4 py-2 rounded-lg hover:bg-gray-400 transition-colors" onclick="document.getElementById('edit-<%= reading.id %>').classList.add('hidden')">キャンセル</button>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="text-center py-16">
      <svg class="w-16 h-16 mx-auto text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
      </svg>
      <h3 class="text-xl font-semibold text-gray-700 mb-2">まだ本が登録されていません</h3>
      <p class="text-gray-600 mb-6">本を探して、読書記録を開始しましょう</p>
      <%= link_to '本を探す', books_path, class: 'inline-block bg-amber-600 text-white px-6 py-3 rounded-lg hover:bg-amber-700 transition-colors' %>
    </div>
  <% end %>
</div>

<script>
  // 編集ボタンをクリックしたときにモーダルを表示
  document.querySelectorAll('a[href*="#edit"]').forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const id = link.href.split('#edit')[1];
      document.getElementById('edit-' + id).classList.remove('hidden');
    });
  });

  // モーダルの外側をクリックしたときに閉じる
  document.querySelectorAll('[id^="edit-"]').forEach(modal => {
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.classList.add('hidden');
      }
    });
  });
</script>

