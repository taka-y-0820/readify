<div class="min-h-screen bg-gradient-to-br from-amber-50 via-orange-50 to-yellow-50 py-8">
  <!-- ヘッダー -->
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 mb-8">
    <div class="flex items-center space-x-3">
      <%= link_to book_path(@book), class: "text-amber-600 hover:text-amber-700 transition-colors" do %>
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      <% end %>
      <h1 class="text-3xl font-bold text-amber-900">読書記録を編集</h1>
    </div>
  </div>

  <!-- メインコンテンツ -->
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-white rounded-2xl shadow-xl p-8">
      <div class="mb-6 pb-6 border-b border-gray-200">
        <h2 class="text-xl font-bold text-gray-900"><%= @book.title %></h2>
        <p class="text-gray-600"><%= @book.author %></p>
      </div>

      <%= form_with model: [@book, @reading], class: "space-y-6" do |f| %>
        
        <% if @reading.errors.any? %>
          <div class="bg-red-50 border border-red-200 rounded-lg p-4">
            <h3 class="text-red-800 font-semibold mb-2">エラーがあります</h3>
            <ul class="list-disc list-inside text-red-700 text-sm space-y-1">
              <% @reading.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="grid grid-cols-2 gap-6">
          <div>
            <%= f.label :started_at, "開始日", class: "block text-sm font-semibold text-gray-700 mb-2" %>
            <%= f.date_field :started_at, 
                class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-transparent transition-all" %>
          </div>

          <div>
            <%= f.label :finished_at, "完了日", class: "block text-sm font-semibold text-gray-700 mb-2" %>
            <%= f.date_field :finished_at, 
                class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-transparent transition-all" %>
          </div>
        </div>

        <div>
          <%= f.label :rating, "評価", class: "block text-sm font-semibold text-gray-700 mb-2" %>
          <%= f.select :rating, 
              (1..5).to_a.reverse.map { |r| ["★" * r, r] }, 
              { include_blank: "評価なし" }, 
              class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-transparent transition-all" %>
        </div>

        <div>
          <%= f.label :review, "レビュー", class: "block text-sm font-semibold text-gray-700 mb-2" %>
          <%= f.text_area :review, rows: 4,
              placeholder: "この本の感想や印象に残ったことを書いてください",
              class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-transparent transition-all" %>
        </div>

        <div>
          <%= f.label :note, "メモ", class: "block text-sm font-semibold text-gray-700 mb-2" %>
          <%= f.text_area :note, rows: 4,
              placeholder: "読書中のメモや気づいたことを記録できます",
              class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-transparent transition-all" %>
        </div>

        <div class="flex gap-4 pt-4">
          <%= f.submit "更新する", 
              class: "flex-1 bg-gradient-to-r from-amber-600 to-orange-600 text-white px-6 py-3 rounded-lg hover:from-amber-700 hover:to-orange-700 transition-all font-semibold shadow-lg transform hover:scale-105" %>
          <%= link_to "キャンセル", book_path(@book), 
              class: "px-6 py-3 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition-colors font-semibold" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
